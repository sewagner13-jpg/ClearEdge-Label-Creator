# Production Environment Configuration for Cloud Run
# These values are set via Cloud Run environment variables and secrets

# Application (set via Cloud Run --set-env-vars)
ENV=production
LOG_LEVEL=INFO
API_PORT=8080
API_HOST=0.0.0.0

# Google Drive (set via Cloud Run --set-env-vars)
SHARED_DRIVE_ID=0APFlqBVg60o6Uk9PVA
ROOT_FOLDER_NAME=Product Labels

# Gemini AI (set via Cloud Run --set-env-vars)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_RETRIES=3

# Secrets (set via Cloud Run --set-secrets)
# GEMINI_API_KEY=<from Secret Manager: gemini-api-key>
# GOOGLE_SERVICE_ACCOUNT_JSON=<from Secret Manager: service-account-json>

# OCR Configuration (set via Cloud Run --set-env-vars)
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANG=eng
OCR_THRESHOLD_CHARS=100

# Web Retrieval (set via Cloud Run --set-env-vars)
ALLOWED_DOMAINS=msds.com,fishersci.com,sigmaaldrich.com,chemicalsafety.com,ehs.com
WEB_RETRIEVAL_TIMEOUT=30

# Label Generation (set via Cloud Run --set-env-vars)
DEFAULT_LABEL_WIDTH=800
DEFAULT_LABEL_HEIGHT=1000
PURPLE_HEADER_COLOR=#5A2D82

# NOTE: For Cloud Run deployment:
# - Use GOOGLE_SERVICE_ACCOUNT_JSON (JSON string from Secret Manager)
# - NOT google_service_account_file (file path for local dev only)
