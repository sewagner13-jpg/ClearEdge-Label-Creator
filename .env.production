# Production Environment Configuration
# These values are set in the hosting platform environment.

ENV=production
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_RETRIES=3
# OPENAI_API_KEY=<set in hosting platform secrets>

TESSERACT_CMD=/usr/bin/tesseract
OCR_LANG=eng
OCR_THRESHOLD_CHARS=100

ALLOWED_DOMAINS=msds.com,fishersci.com,sigmaaldrich.com,chemicalsafety.com,ehs.com
WEB_RETRIEVAL_TIMEOUT=30

DEFAULT_LABEL_WIDTH=800
DEFAULT_LABEL_HEIGHT=1000
PURPLE_HEADER_COLOR=#5A2D82
