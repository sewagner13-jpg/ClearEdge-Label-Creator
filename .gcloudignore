# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
.hypothesis/
tests/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment (use Secret Manager instead)
.env
.env.*
*.key
*.json
service-account-key.json

# Documentation
*.md
docs/

# Build artifacts
*.egg-info
dist/
build/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Deployment scripts (not needed in container)
scripts/
deployment/
