# ============================================================================
# CLEAR EDGE Label Pipeline - Local Development Configuration
# ============================================================================
# Copy this file to .env and update with your actual credentials
# For production/Cloud Run deployment, see .env.production
# ============================================================================

# OpenAI API Key (from platform.openai.com)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_RETRIES=3

# Google Drive Configuration
SHARED_DRIVE_ID=0APFlqBVg60o6Uk9PVA
ROOT_FOLDER_NAME=Product Labels

# Service Account Credentials (LOCAL DEVELOPMENT ONLY)
# For Cloud Run, use GOOGLE_SERVICE_ACCOUNT_JSON from Secret Manager
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account-key.json

# Application Configuration
ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANG=eng
OCR_THRESHOLD_CHARS=100

# Web Retrieval Allowlist (comma-separated domains)
ALLOWED_DOMAINS=msds.com,fishersci.com,sigmaaldrich.com,chemicalsafety.com,ehs.com
WEB_RETRIEVAL_TIMEOUT=30

# Label Generation
DEFAULT_LABEL_WIDTH=800
DEFAULT_LABEL_HEIGHT=1000
PURPLE_HEADER_COLOR=#5A2D82
