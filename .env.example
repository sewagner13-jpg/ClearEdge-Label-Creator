# ============================================================================
# CLEAR EDGE Label Pipeline - Local Development Configuration
# ============================================================================
# Copy this file to .env and update with your actual credentials
# For hosted deployment, set environment variables in Railway.
# ============================================================================

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_RETRIES=3
OPENAI_REVIEW_ENABLED=true
# Optional. Leave blank to use OPENAI_MODEL for the second-pass source review.
OPENAI_REVIEW_MODEL=

# Application Configuration
ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANG=eng
OCR_THRESHOLD_CHARS=100

# Web Retrieval Allowlist (comma-separated domains)
ALLOWED_DOMAINS=msds.com,fishersci.com,sigmaaldrich.com,chemicalsafety.com,ehs.com
WEB_RETRIEVAL_TIMEOUT=30

# Label Generation
DEFAULT_LABEL_WIDTH=800
DEFAULT_LABEL_HEIGHT=1000
PURPLE_HEADER_COLOR=#5A2D82
